# Local development only. Copy to .env and replace values as appropriate.
ONEISSUER_ENV=development
ONEISSUER_ISSUER=http://localhost:8080
ONEISSUER_HTTP_ADDR=:8080
ONEISSUER_DATABASE_URL=postgresql://oneissuer:oneissuer-local-only@localhost:5432/oneissuer?sslmode=disable
ONEISSUER_DATABASE_MAX_CONNS=10
# Generate this local-only file with:
#   mkdir -p .oneissuer-dev
#   go run ./cmd/oneissuer keys generate --alg RS256 --out .oneissuer-dev/signing-key.jwk
ONEISSUER_SIGNING_KEY_FILE=.oneissuer-dev/signing-key.jwk
# Compose bind-mount source (resolved relative to deploy/docker-compose.yml).
# On Linux, keep mode 0600 and make UID/GID 65532 the owner before starting the
# non-root container; see docs/key-rotation-runbook.md.
ONEISSUER_SIGNING_KEY_HOST_FILE=../.oneissuer-dev/signing-key.jwk
# Optional public-only JWKS used during restart-based key overlap/rotation.
ONEISSUER_VERIFICATION_KEYS_FILE=
ONEISSUER_AUTHORIZATION_CODE_TTL=1m
ONEISSUER_ID_TOKEN_TTL=5m
ONEISSUER_ACCESS_TOKEN_TTL=10m
ONEISSUER_OIDC_CLOCK_SKEW=30s
ONEISSUER_LOG_LEVEL=info
ONEISSUER_LOG_FORMAT=json
ONEISSUER_SHUTDOWN_TIMEOUT=15s
ONEISSUER_HTTP_READ_HEADER_TIMEOUT=5s
ONEISSUER_HTTP_READ_TIMEOUT=10s
ONEISSUER_HTTP_WRITE_TIMEOUT=30s
ONEISSUER_HTTP_IDLE_TIMEOUT=60s
ONEISSUER_HTTP_MAX_HEADER_BYTES=1048576
ONEISSUER_TRUSTED_PROXIES=
ONEISSUER_COOKIE_NAME=oneissuer_session
ONEISSUER_COOKIE_SECURE=false
ONEISSUER_SESSION_TTL=24h
ONEISSUER_SESSION_IDLE_TIMEOUT=2h
ONEISSUER_CSRF_TTL=15m
ONEISSUER_AUTH_TRANSACTION_TTL=10m
ONEISSUER_LOGIN_REAUTH_WINDOW=15m
ONEISSUER_CLEANUP_INTERVAL=5m
# Registration is deny-by-default. Set true only for an intentional local demo.
ONEISSUER_REGISTRATION_ENABLED=false
ONEISSUER_PASSWORD_MIN_LENGTH=15
ONEISSUER_PASSWORD_MAX_BYTES=1024
ONEISSUER_ARGON2_MEMORY_KIB=65536
ONEISSUER_ARGON2_TIME=3
ONEISSUER_ARGON2_THREADS=2
ONEISSUER_ARGON2_MAX_CONCURRENT=2

# Docker Compose's PostgreSQL service. These intentionally weak values are for
# an isolated developer workstation and must never be reused in production.
POSTGRES_USER=oneissuer
POSTGRES_PASSWORD=oneissuer-local-only
POSTGRES_DB=oneissuer
POSTGRES_PORT=5432

# Optional local image build override. Keep a trusted proxy first and retain
# direct only if the deployment policy permits direct module downloads.
ONEISSUER_BUILD_GOPROXY=https://proxy.golang.org,direct
ONEISSUER_HTTP_PORT=8080
ONEISSUER_CONTAINER_STOP_GRACE_PERIOD=20s

# Optional A/B interoperability example. Client IDs and the confidential
# one-time Secret are created at runtime and must never be committed.
EXAMPLE_CLIENT_A_PORT=8081
EXAMPLE_CLIENT_A_ID=
EXAMPLE_CLIENT_A_REDIRECT_URI=http://127.0.0.1:8081/callback
EXAMPLE_CLIENT_B_PORT=8082
EXAMPLE_CLIENT_B_ID=
EXAMPLE_CLIENT_B_REDIRECT_URI=http://127.0.0.1:8082/callback
EXAMPLE_CLIENT_B_SECRET_FILE=../.oneissuer-dev/client-b-secret
