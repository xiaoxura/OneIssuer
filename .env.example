# Local development only. Copy to .env and replace values as appropriate.
ONEISSUER_ENV=development
ONEISSUER_ISSUER=http://localhost:8080
ONEISSUER_HTTP_ADDR=:8080
ONEISSUER_DATABASE_URL=postgresql://oneissuer:oneissuer-local-only@localhost:5432/oneissuer?sslmode=disable
ONEISSUER_DATABASE_MAX_CONNS=10
ONEISSUER_LOG_LEVEL=info
ONEISSUER_LOG_FORMAT=json
ONEISSUER_SHUTDOWN_TIMEOUT=15s
ONEISSUER_HTTP_READ_HEADER_TIMEOUT=5s
ONEISSUER_HTTP_READ_TIMEOUT=10s
ONEISSUER_HTTP_WRITE_TIMEOUT=30s
ONEISSUER_HTTP_IDLE_TIMEOUT=60s
ONEISSUER_HTTP_MAX_HEADER_BYTES=1048576
ONEISSUER_TRUSTED_PROXIES=
ONEISSUER_COOKIE_NAME=oneissuer_session
ONEISSUER_COOKIE_SECURE=false
ONEISSUER_SESSION_TTL=24h
ONEISSUER_SESSION_IDLE_TIMEOUT=2h
ONEISSUER_CSRF_TTL=15m
ONEISSUER_AUTH_TRANSACTION_TTL=10m
ONEISSUER_LOGIN_REAUTH_WINDOW=15m
ONEISSUER_CLEANUP_INTERVAL=5m
# Registration is deny-by-default. Set true only for an intentional local demo.
ONEISSUER_REGISTRATION_ENABLED=false
ONEISSUER_PASSWORD_MIN_LENGTH=15
ONEISSUER_PASSWORD_MAX_BYTES=1024
ONEISSUER_ARGON2_MEMORY_KIB=65536
ONEISSUER_ARGON2_TIME=3
ONEISSUER_ARGON2_THREADS=2
ONEISSUER_ARGON2_MAX_CONCURRENT=2

# Docker Compose's PostgreSQL service. These intentionally weak values are for
# an isolated developer workstation and must never be reused in production.
POSTGRES_USER=oneissuer
POSTGRES_PASSWORD=oneissuer-local-only
POSTGRES_DB=oneissuer
POSTGRES_PORT=5432
